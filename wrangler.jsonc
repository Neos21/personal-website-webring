{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website-webring",
  "compatibility_date": "2026-01-13",
  "account_id": "07100c21a5c21a0afb93ab435ba46712",
  "main": "./server/index.ts",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-website-webring",
      "database_id": "508cba73-65f6-43f5-bb43-b688668ad962"
    }
  ],
  "routes": [
    {
      "pattern": "personal-website-webring.neos21.net",  // 独自ドメインに割り当てる
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "workers_dev": false,  // `workers.dev` ドメインを無効にする
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "placement": {
    "mode": "smart"
  }
}
